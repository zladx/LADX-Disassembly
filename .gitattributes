# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.md5  text eol=lf

# Enforce encoding and syntax highlighting for VC patch templates
*.patch.template text eol=crlf linguist-language=INI
